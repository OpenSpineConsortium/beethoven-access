   "type": "object"
  },
  "grid-token.answer": {
   "type": "object",
   "required": [
    "token",
    "made_at",
    "replaced"
   ],
   "properties": {
    "token": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "description": "the grid token: 32 random bytes as 64 lower-case hexadecimal characters, in this answer only (the service keeps its SHA-256, and the answer is cache-control: no-store); the admin page saves it as the file grid_token"
    },
    "made_at": {
     "$ref": "common.schema.json#/$defs/time"
    },
    "replaced": {
     "type": "boolean",
     "description": "true when an earlier grid token was taken away by this one"
    }
   }
  },
  "grid-token.status.answer": {
   "type": "object",
   "description": "made_at: when the grid token was made, null when there is none; last_read_at: when it last read a list, recorded once an hour at most, null when it has not read one since it was made. Never the token or its hash.",
   "required": [
    "made_at",
    "last_read_at"
   ],
   "properties": {
    "made_at": {
     "$ref": "common.schema.json#/$defs/time_or_null"
    },
    "last_read_at": {
     "$ref": "common.schema.json#/$defs/time_or_null"
    }
   },
   "not": {
    "anyOf": [
     {
      "required": [
       "token"
      ]
     },
     {
      "required": [
       "sha256"
      ]
     }
    ]
   }
  },
